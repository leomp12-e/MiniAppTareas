{
    "name": "dam/biblioteca",
    "description": "MiniApp de Biblioteca con POO, namespaces y Composer",
    "type": "project",
    "require": {
        "php": ">=8.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0"
    }
}
